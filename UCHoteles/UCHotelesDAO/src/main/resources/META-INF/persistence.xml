<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="UCHotelesPU" transaction-type="JTA">
        <jta-data-source>jdbc/UCHotelesDB</jta-data-source>
        <class>es.unican.ps.clases.Hotel</class>
        <class>es.unican.ps.clases.Habitacion</class>
        <class>es.unican.ps.clases.Reserva</class>
        <class>es.unican.ps.clases.ReservaTipoHabitacion</class>
        <class>es.unican.ps.clases.DatosCliente</class>
        <class>es.unican.ps.clases.DatosPago</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>
</persistence>