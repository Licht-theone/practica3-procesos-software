<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.unican.ps</groupId>
    <artifactId>UCHoteles</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>UCHotelesEAR</artifactId>
  <packaging>ear</packaging>

  <dependencies>
    <dependency>
      <groupId>es.unican.ps</groupId>
      <artifactId>UCHotelesCommon</artifactId>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>es.unican.ps</groupId>
      <artifactId>UCHotelesDAO</artifactId>
      <version>0.0.1-SNAPSHOT</version>
      <type>ejb</type>
    </dependency>
    <dependency>
      <groupId>es.unican.ps</groupId>
      <artifactId>UCHotelesBusiness</artifactId>
      <version>0.0.1-SNAPSHOT</version>
      <type>ejb</type>
    </dependency>
    <dependency>
      <groupId>es.unican.ps</groupId>
      <artifactId>UCHotelesWeb</artifactId>
      <version>0.0.1-SNAPSHOT</version>
      <type>war</type>
    </dependency>
  </dependencies>

  <build>
    <finalName>UCHoteles</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-ear-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <version>10</version>
          <defaultLibBundleDir>lib</defaultLibBundleDir>
          <generateApplicationXml>true</generateApplicationXml>
          <modules>
            <ejbModule>
              <groupId>es.unican.ps</groupId>
              <artifactId>UCHotelesDAO</artifactId>
              <bundleFileName>UCHotelesDAO.jar</bundleFileName>
            </ejbModule>
            <ejbModule>
              <groupId>es.unican.ps</groupId>
              <artifactId>UCHotelesBusiness</artifactId>
              <bundleFileName>UCHotelesBusiness.jar</bundleFileName>
            </ejbModule>
            <webModule>
              <groupId>es.unican.ps</groupId>
              <artifactId>UCHotelesWeb</artifactId>
              <bundleFileName>UCHotelesWeb.war</bundleFileName>
              <contextRoot>/UCHotelesWeb</contextRoot>
            </webModule>
          </modules>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
